# Node 24. Runtime database; never supply production secrets during image build.
# Local native development: provision PostgreSQL, then npm run db:migrate and npm run db:seed.
DATABASE_URL=postgresql://lumina_app:REPLACE_ME@localhost:5432/lumina
# Dedicated integration-test DB only; name must end in _test. Never production.
TEST_DATABASE_URL=

# Canonical browser-facing origin. Production MUST be HTTPS.
AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google callback = AUTH_URL + /api/auth/google/callback

# Optional demo entrypoint on /masuk. Server-only: the password never reaches
# the browser. The account is created on first use if it does not exist yet;
# leave either blank and the button reports "not configured" instead.
LUMINA_DEMO_EMAIL=
LUMINA_DEMO_PASSWORD=

# Optional AI provider reachable FROM the app container.
# Questions/digest or OCR images go to the provider; inspected message scoring stays local.
# Empty URL/model selects offline templates (503 not-configured from AI routes).
LUMINA_LLM_URL=
LUMINA_LLM_MODEL=
LUMINA_LLM_KEY=
# Optional: retry on 429/5xx with a second model on the same endpoint.
LUMINA_LLM_FALLBACK_MODEL=
# Optional: override the primary model's reasoning_effort (default: none).
# Leave the fallback empty to omit the field for models that reject "none".
LUMINA_LLM_REASONING_EFFORT=
LUMINA_LLM_FALLBACK_REASONING_EFFORT=
LUMINA_AI_GLOBAL_LIMIT=100

# Optional link verification via a url.vet-compatible scanner (AGPL-3.0).
# Unset = public https://api.url.vet (20 req/min per IP; the link is sent there).
# Set to `off` to disable, or to your self-hosted instance in production.
URLVET_API_URL=
# Loker scanner data root (portals, pipeline, reports). Must be writable.
# Default: <cwd>/.scan-data; the container image uses /app/.scan-data.
LOKER_SCAN_DATA_DIR=
# Background prewarm cadence in milliseconds. The server crawls shortly after
# boot and then once per interval, so the card opens with rows already present.
# Default 21600000 (6 h); a failed run retries after 30 min. 0 disables it.
LOKER_PREWARM_INTERVAL_MS=

# Enable ONLY with Caddy overwriting X-Lumina-Client-IP and no public app port.
TRUST_PROXY=false

# Production Compose: use `docker compose --env-file .env.production ...`.
# Generate separate hex-only passwords: openssl rand -hex 32
DOMAIN=lumina.example.com
POSTGRES_DB=lumina
POSTGRES_PASSWORD=REPLACE_WITH_ADMIN_HEX_PASSWORD
APP_DB_PASSWORD=REPLACE_WITH_APP_HEX_PASSWORD
# Compose derives DATABASE_URL from APP_DB_PASSWORD and the internal hostname db.
# Optional image tag for releases/rollback (must remain PostgreSQL-compatible).
APP_IMAGE=lumina:local

# Optional comma-separated existing account UUIDs allowed to review community reports.
COMMUNITY_MODERATOR_IDS=

# Coding tools are a separate capability. Empty means nobody can open /studio.
# Comma-separated account UUIDs, independent from COMMUNITY_MODERATOR_IDS.
STUDIO_ALLOWED_IDS=
# Absolute host directory holding one workspace per account. Never inside the repo.
STUDIO_WORKSPACE_ROOT=/var/lib/lumina-studio/workspaces
# Optional extra instructions appended to Studio's system prompt, for this host.
STUDIO_APPEND_PROMPT=

# The real planner -> specialists -> synthesizer Orchestrator is on by default.
# Set to 0 to fall back to the single voice call (e.g. no chat-completions endpoint).
LUMINA_COMPANION_ORCHESTRATOR=1
# Serial-run deadline in ms. Default 120000 for serial runs; maximum 180000.
LUMINA_ORCHESTRATOR_DEADLINE_MS=120000
# Lumina may author the final score from grounded agent consensus.
# Set to 0 to keep the engine score.
LUMINA_CONSENSUS_SCORE=1

# Optional comma-separated opencode2api lane bases (separate egress IPs).
LUMINA_LLM_LANES=
LUMINA_LLM_LANE_KEY=
