# Signed demo-session cookie key.
# Required in production (min 16 chars). Dev falls back to a fixed, harmless
# value so `next dev` restarts keep the cookie valid.
AUTH_SECRET=change-me-to-a-random-32-char-string

# Optional language layer. Any OpenAI-compatible endpoint, e.g.
#   LUMINA_LLM_URL=http://127.0.0.1:20138/v1
#   LUMINA_LLM_MODEL=<model id from GET /v1/models>
# When unset, the chat falls back to src/lib/companion/reply.ts and makes no
# network call at all. That fallback is the demo path at a venue with no
# network, so it must read as finished, not broken.
# Only the signal digest is sent — never the user's message (plan 11.6a).
LUMINA_LLM_URL=
LUMINA_LLM_MODEL=
LUMINA_LLM_KEY=
