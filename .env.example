# Node.js >=22.13. SQLite file must live on persistent storage in production.
AUTH_DATABASE_PATH=./data/auth.sqlite

# Canonical app origin. Required for Google OAuth in production (HTTPS).
AUTH_URL=http://localhost:3000
# Google Cloud OAuth client, application type: Web application.
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
# Use your HTTPS origin + /api/auth/google/callback for production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional language layer. Any OpenAI-compatible endpoint, e.g.
#   LUMINA_LLM_URL=http://127.0.0.1:20138/v1
#   LUMINA_LLM_MODEL=<model id from GET /v1/models>
# When unset, the chat falls back to src/lib/companion/reply.ts and makes no
# network call at all. That fallback is the demo path at a venue with no
# network, so it must read as finished, not broken.
# Only the signal digest is sent — never the user's message (plan 11.6a).
LUMINA_LLM_URL=
LUMINA_LLM_MODEL=
LUMINA_LLM_KEY=
